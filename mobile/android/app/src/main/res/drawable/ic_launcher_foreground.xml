<?xml version="1.0" encoding="utf-8"?>
<!--
  前景层:终端提示符 >_ ,与桌面版 build/icon.svg 同一个标识。

  尺寸怎么定的(别再按"原图多大就多大"来放):
  自适应图标的画布是 108dp,但**只有中间 72dp 是可见的**,外圈 18dp 一圈会被启动器的
  遮罩裁掉。桌面版里符号占整块图标的 53.2%,如果在这里也按 53.2% 的画布宽度放,
  换算到可见区域就是 53.2% x 108/72 = 79.8% —— 撑满整个图标、四周没有空隙。
  所以要按可见区域算:符号宽 = 0.532 x 72/108 x 1024 = 363 单位(相当于原图缩放 0.666)。
  这样看上去才和桌面版一样,四周留得出气。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path
        android:pathData="M363.2,420.1L500.3,512L363.2,603.9"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="65.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M558.3,603.2L663.5,603.2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="59.9"
        android:strokeLineCap="round" />
</vector>
