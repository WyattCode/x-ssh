  画在 24dp 里、四周留出约 2dp,否则会被状态栏裁到。
  之前用的是系统自带的蓝牙图标占位 —— 通知栏里显示成一个蓝牙,很误导。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:pathData="M4.21,7.28L11.39,12.09L4.21,16.9"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.42"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M14.42,16.87L19.93,16.87"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.14"
        android:strokeLineCap="round" />
</vector>
