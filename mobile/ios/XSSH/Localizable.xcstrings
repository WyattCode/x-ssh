    "The key is stored in the Keychain on this device. Add the public key to ~/.ssh/authorized_keys on the server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is stored in the Keychain on this device. Add the public key to ~/.ssh/authorized_keys on the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥存在本机钥匙串里。把公钥加到服务器的 ~/.ssh/authorized_keys。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私鑰存在本機鑰匙圈裡。把公鑰加到伺服器的 ~/.ssh/authorized_keys。"
          }
        }
      }
    },
    "The private key needs a passphrase, or the one saved is wrong. Edit the host to fix it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private key needs a passphrase, or the one saved is wrong. Edit the host to fix it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这把私钥需要口令,或保存的口令不对。编辑这台主机来修正。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這把私鑰需要口令,或儲存的口令不對。編輯這台主機來修正。"
          }
        }
      }
    },
