    "The server presented a different key than the one you trusted. This can mean the server was reinstalled — or that someone is intercepting the connection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server presented a different key than the one you trusted. This can mean the server was reinstalled — or that someone is intercepting the connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器出示的密钥与你信任过的不同。可能是服务器重装了,也可能有人在中间截获连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器出示的金鑰與你信任過的不同。可能是伺服器重裝了,也可能有人在中間攔截連線。"
          }
        }
      }
    },
